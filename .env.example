# PostgreSQL российского production-контура. Не добавляйте реальное значение в Git.
DATABASE_URL=
DATABASE_SSL_MODE=require

# Preview не блокируется незаполненными реквизитами. Для реального запуска
# установите production: сборка остановится, если критические данные отсутствуют.
NEXT_PUBLIC_DEPLOYMENT_STAGE=preview

# Единая публичная конфигурация бизнеса. Не подставляйте тестовые реквизиты.
NEXT_PUBLIC_BRAND_NAME=APEX WHEELS
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SELLER_LEGAL_NAME=
NEXT_PUBLIC_SELLER_LAST_NAME=
NEXT_PUBLIC_SELLER_FIRST_NAME=
NEXT_PUBLIC_SELLER_PATRONYMIC=
NEXT_PUBLIC_SELLER_INN=
NEXT_PUBLIC_SELLER_OGRNIP=
NEXT_PUBLIC_SELLER_LEGAL_ADDRESS=
NEXT_PUBLIC_SELLER_ACTUAL_ADDRESS=
NEXT_PUBLIC_SELLER_RETURN_ADDRESS=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ADDITIONAL_PHONES=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WORKING_HOURS=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_LATITUDE=
NEXT_PUBLIC_STORE_LONGITUDE=
NEXT_PUBLIC_TWO_GIS_URL=https://2gis.ru/barnaul/firm/70000001036958402/tab/reviews?m=83.75635%2C53.376061%2F16
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_VK_URL=

# Возможности включаются только после подтверждения заказчиком.
NEXT_PUBLIC_PICKUP_ENABLED=false
NEXT_PUBLIC_PICKUP_RULES=
NEXT_PUBLIC_CITY_DELIVERY_ENABLED=false
NEXT_PUBLIC_CITY_DELIVERY_RULES=
NEXT_PUBLIC_REGIONAL_DELIVERY_ENABLED=false
NEXT_PUBLIC_REGIONAL_DELIVERY_RULES=
NEXT_PUBLIC_TIRE_SERVICE_ENABLED=false
NEXT_PUBLIC_TIRE_STORAGE_ENABLED=false
NEXT_PUBLIC_BALANCING_ENABLED=false
NEXT_PUBLIC_INSTALLATION_ENABLED=false
NEXT_PUBLIC_OTHER_SERVICES=
NEXT_PUBLIC_USED_PRODUCTS_ENABLED=false
NEXT_PUBLIC_RATINGS_ENABLED=false
NEXT_PUBLIC_INSTALLMENT_ENABLED=false
NEXT_PUBLIC_AVAILABILITY_DISPLAY_MODE=on_request
NEXT_PUBLIC_CATALOG_DATA_MODE=preview
NEXT_PUBLIC_LOGO_SOURCE=
NEXT_PUBLIC_FAVICON_SOURCE=/icon.svg
NEXT_PUBLIC_OPEN_GRAPH_IMAGE_SOURCE=

# Необязательные подтвержденные показатели. Пустое значение скрывает claim.
NEXT_PUBLIC_CONFIRMED_YEARS_EXPERIENCE=
NEXT_PUBLIC_CONFIRMED_RATING=
NEXT_PUBLIC_CONFIRMED_CLIENT_COUNT=
NEXT_PUBLIC_CONFIRMED_RETURN_DAYS=

# Параметры Docker Compose production-контура.
POSTGRES_DB=apex_wheels
POSTGRES_USER=apex_user
POSTGRES_PASSWORD=
SITE_HOST=

# Ключ входящих запросов из 1С.
INTEGRATION_API_KEY=

# Будущий HTTP-сервис 1С. До получения параметров заказчика оставьте пустым.
ONEC_BASE_URL=
ONEC_API_KEY=
ONEC_API_KEY_HEADER=X-API-Key
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_REQUEST_TIMEOUT_MS=8000
ONEC_SAFE_RETRY_COUNT=2

# Числовой ID счётчика. Скрипт Метрики загрузится только после согласия.
YANDEX_METRIKA_COUNTER_ID=

# Случайная строка не короче 32 байт для HMAC-хешей OTP и сессий.
# Хранить только как secret, при ротации завершатся все активные сессии.
OTP_CODE_PEPPER=
INTERNAL_JOB_SECRET=

# Статический ключ сервисного аккаунта Yandex Cloud с ролью postbox.sender.
YANDEX_POSTBOX_ACCESS_KEY_ID=
YANDEX_POSTBOX_SECRET_ACCESS_KEY=

# Верифицированный в Postbox адрес отправителя и отображаемое имя.
YANDEX_POSTBOX_FROM_EMAIL=
YANDEX_POSTBOX_FROM_NAME=APEX WHEELS

# Размер транзакционного пакета, не размер всего файла (100–2000).
CATALOG_IMPORT_BATCH_SIZE=1000
FITMENT_IMPORT_BATCH_SIZE=1000
ORDER_NUMBER_PREFIX=AW
# Внутренний срок резерва, не обещание покупателю. Нужен cleanup job.
ORDER_RESERVATION_TTL_HOURS=24
