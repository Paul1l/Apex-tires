FROM node:22-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
ARG NEXT_PUBLIC_DEPLOYMENT_STAGE=production
ARG NEXT_PUBLIC_BRAND_NAME
ARG NEXT_PUBLIC_BUSINESS_NAME
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SELLER_LEGAL_NAME
ARG NEXT_PUBLIC_SELLER_LAST_NAME
ARG NEXT_PUBLIC_SELLER_FIRST_NAME
ARG NEXT_PUBLIC_SELLER_PATRONYMIC
ARG NEXT_PUBLIC_SELLER_LEGAL_ADDRESS
ARG NEXT_PUBLIC_SELLER_ACTUAL_ADDRESS
ARG NEXT_PUBLIC_SELLER_RETURN_ADDRESS
ARG NEXT_PUBLIC_SELLER_INN
ARG NEXT_PUBLIC_SELLER_OGRNIP
ARG NEXT_PUBLIC_CONTACT_PHONE
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_ADDITIONAL_PHONES
ARG NEXT_PUBLIC_STORE_ADDRESS
ARG NEXT_PUBLIC_STORE_LATITUDE
ARG NEXT_PUBLIC_STORE_LONGITUDE
ARG NEXT_PUBLIC_TWO_GIS_URL
ARG NEXT_PUBLIC_WHATSAPP_URL
ARG NEXT_PUBLIC_TELEGRAM_URL
ARG NEXT_PUBLIC_VK_URL
ARG NEXT_PUBLIC_WORKING_HOURS
ARG NEXT_PUBLIC_PICKUP_ENABLED=false
ARG NEXT_PUBLIC_PICKUP_RULES
ARG NEXT_PUBLIC_CITY_DELIVERY_ENABLED=false
ARG NEXT_PUBLIC_CITY_DELIVERY_RULES
ARG NEXT_PUBLIC_REGIONAL_DELIVERY_ENABLED=false
ARG NEXT_PUBLIC_REGIONAL_DELIVERY_RULES
ARG NEXT_PUBLIC_TIRE_SERVICE_ENABLED=false
ARG NEXT_PUBLIC_TIRE_STORAGE_ENABLED=false
ARG NEXT_PUBLIC_BALANCING_ENABLED=false
ARG NEXT_PUBLIC_INSTALLATION_ENABLED=false
ARG NEXT_PUBLIC_USED_PRODUCTS_ENABLED=false
ARG NEXT_PUBLIC_RATINGS_ENABLED=false
ARG NEXT_PUBLIC_AVAILABILITY_DISPLAY_MODE=available
ARG NEXT_PUBLIC_CATALOG_DATA_MODE=database
ENV NEXT_PUBLIC_DEPLOYMENT_STAGE=$NEXT_PUBLIC_DEPLOYMENT_STAGE
ENV NEXT_PUBLIC_BRAND_NAME=$NEXT_PUBLIC_BRAND_NAME
ENV NEXT_PUBLIC_BUSINESS_NAME=$NEXT_PUBLIC_BUSINESS_NAME
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SELLER_LEGAL_NAME=$NEXT_PUBLIC_SELLER_LEGAL_NAME
ENV NEXT_PUBLIC_SELLER_LAST_NAME=$NEXT_PUBLIC_SELLER_LAST_NAME
ENV NEXT_PUBLIC_SELLER_FIRST_NAME=$NEXT_PUBLIC_SELLER_FIRST_NAME
ENV NEXT_PUBLIC_SELLER_PATRONYMIC=$NEXT_PUBLIC_SELLER_PATRONYMIC
ENV NEXT_PUBLIC_SELLER_LEGAL_ADDRESS=$NEXT_PUBLIC_SELLER_LEGAL_ADDRESS
ENV NEXT_PUBLIC_SELLER_ACTUAL_ADDRESS=$NEXT_PUBLIC_SELLER_ACTUAL_ADDRESS
ENV NEXT_PUBLIC_SELLER_RETURN_ADDRESS=$NEXT_PUBLIC_SELLER_RETURN_ADDRESS
ENV NEXT_PUBLIC_SELLER_INN=$NEXT_PUBLIC_SELLER_INN
ENV NEXT_PUBLIC_SELLER_OGRNIP=$NEXT_PUBLIC_SELLER_OGRNIP
ENV NEXT_PUBLIC_CONTACT_PHONE=$NEXT_PUBLIC_CONTACT_PHONE
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL
ENV NEXT_PUBLIC_ADDITIONAL_PHONES=$NEXT_PUBLIC_ADDITIONAL_PHONES
ENV NEXT_PUBLIC_STORE_ADDRESS=$NEXT_PUBLIC_STORE_ADDRESS
ENV NEXT_PUBLIC_STORE_LATITUDE=$NEXT_PUBLIC_STORE_LATITUDE
ENV NEXT_PUBLIC_STORE_LONGITUDE=$NEXT_PUBLIC_STORE_LONGITUDE
ENV NEXT_PUBLIC_TWO_GIS_URL=$NEXT_PUBLIC_TWO_GIS_URL
ENV NEXT_PUBLIC_WHATSAPP_URL=$NEXT_PUBLIC_WHATSAPP_URL
ENV NEXT_PUBLIC_TELEGRAM_URL=$NEXT_PUBLIC_TELEGRAM_URL
ENV NEXT_PUBLIC_VK_URL=$NEXT_PUBLIC_VK_URL
ENV NEXT_PUBLIC_WORKING_HOURS=$NEXT_PUBLIC_WORKING_HOURS
ENV NEXT_PUBLIC_PICKUP_ENABLED=$NEXT_PUBLIC_PICKUP_ENABLED
ENV NEXT_PUBLIC_PICKUP_RULES=$NEXT_PUBLIC_PICKUP_RULES
ENV NEXT_PUBLIC_CITY_DELIVERY_ENABLED=$NEXT_PUBLIC_CITY_DELIVERY_ENABLED
ENV NEXT_PUBLIC_CITY_DELIVERY_RULES=$NEXT_PUBLIC_CITY_DELIVERY_RULES
ENV NEXT_PUBLIC_REGIONAL_DELIVERY_ENABLED=$NEXT_PUBLIC_REGIONAL_DELIVERY_ENABLED
ENV NEXT_PUBLIC_REGIONAL_DELIVERY_RULES=$NEXT_PUBLIC_REGIONAL_DELIVERY_RULES
ENV NEXT_PUBLIC_TIRE_SERVICE_ENABLED=$NEXT_PUBLIC_TIRE_SERVICE_ENABLED
ENV NEXT_PUBLIC_TIRE_STORAGE_ENABLED=$NEXT_PUBLIC_TIRE_STORAGE_ENABLED
ENV NEXT_PUBLIC_BALANCING_ENABLED=$NEXT_PUBLIC_BALANCING_ENABLED
ENV NEXT_PUBLIC_INSTALLATION_ENABLED=$NEXT_PUBLIC_INSTALLATION_ENABLED
ENV NEXT_PUBLIC_USED_PRODUCTS_ENABLED=$NEXT_PUBLIC_USED_PRODUCTS_ENABLED
ENV NEXT_PUBLIC_RATINGS_ENABLED=$NEXT_PUBLIC_RATINGS_ENABLED
ENV NEXT_PUBLIC_AVAILABILITY_DISPLAY_MODE=$NEXT_PUBLIC_AVAILABILITY_DISPLAY_MODE
ENV NEXT_PUBLIC_CATALOG_DATA_MODE=$NEXT_PUBLIC_CATALOG_DATA_MODE
COPY . .
RUN pnpm build

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && useradd --create-home --uid 10001 apex
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.ts ./next.config.ts
COPY --from=builder /app/server ./server
COPY --from=builder /app/config ./config
COPY --from=builder /app/lib ./lib
COPY --from=builder /app/tsconfig.json ./tsconfig.json
USER apex
EXPOSE 3000
CMD ["pnpm", "exec", "next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
