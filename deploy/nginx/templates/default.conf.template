server_tokens off;

server {
  listen 80;
  server_name ${SITE_HOST};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  server_name ${SITE_HOST};

  ssl_certificate /etc/letsencrypt/live/${SITE_HOST}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SITE_HOST}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  # HSTS is set only here: the application does not know about TLS.
  # nosniff and Referrer-Policy are also set here so that nginx's own responses
  # (413, 502, redirects) carry them; the application's copies are hidden to
  # avoid duplicate headers. X-Frame-Options, Content-Security-Policy and
  # Permissions-Policy come from the application (next.config.ts headers()),
  # so a future per-request CSP nonce is not overridden by nginx.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header Referrer-Policy;

  client_max_body_size 6m;

  # Client address for the application (TRUSTED_PROXY=nginx reads X-Real-IP).
  # Client-supplied X-Forwarded-For and CF-Connecting-IP are replaced/removed,
  # so they cannot be used to spoof the address.
  location /api/admin/imports/ {
    client_max_body_size 200m;
    proxy_request_buffering off;
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    proxy_pass http://app:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }
}
